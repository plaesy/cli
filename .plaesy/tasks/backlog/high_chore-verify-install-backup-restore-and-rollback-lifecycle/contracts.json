{
  "id": "high_chore-verify-install-backup-restore-and-rollback-lifecycle",
  "checklist": [
    {
      "id": "task-file-present",
      "check": "Task file exists",
      "run": "test -s .plaesy/tasks/*/high_chore-verify-install-backup-restore-and-rollback-lifecycle/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "acceptance-section-present",
      "check": "Task has acceptance criteria section",
      "run": "grep -q '^## Acceptance criteria' .plaesy/tasks/*/high_chore-verify-install-backup-restore-and-rollback-lifecycle/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "spec-index-lists-task",
      "check": "Spec task index lists this task",
      "run": "grep -q 'high_chore-verify-install-backup-restore-and-rollback-lifecycle' .plaesy/spec/plaesy-agent-platform/spec.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "frontmatter-present",
      "check": "task.md has spec, topic and status frontmatter",
      "run": "head -1 .plaesy/tasks/*/high_chore-verify-install-backup-restore-and-rollback-lifecycle/task.md | grep -q '^---$' && grep -q '^spec:' .plaesy/tasks/*/high_chore-verify-install-backup-restore-and-rollback-lifecycle/task.md && grep -q '^status:' .plaesy/tasks/*/high_chore-verify-install-backup-restore-and-rollback-lifecycle/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "focused-tests",
      "check": "install_e2e test target lists at least one test",
      "run": "export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo test --locked -p plaesy --test install_e2e -- --list 2>&1 | grep -c ': test$'",
      "expected": ">= 1",
      "status": "pending",
      "evidence": "test"
    }
  ]
}
