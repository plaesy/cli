      "check": "task.md has spec, topic and status frontmatter",
      "run": "head -1 .plaesy/tasks/*/high_feature-implement-visual-flow-editor-and-codegen/task.md | grep -q '^---$' && grep -q '^spec:' .plaesy/tasks/*/high_feature-implement-visual-flow-editor-and-codegen/task.md && grep -q '^status:' .plaesy/tasks/*/high_feature-implement-visual-flow-editor-and-codegen/task.md",
