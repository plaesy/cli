{
  "id": "high_feature-implement-design-code-ir-round-trip",
  "checklist": [
    {
      "id": "task-file-present",
      "check": "Task file exists",
      "run": "test -s .plaesy/tasks/*/high_feature-implement-design-code-ir-round-trip/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "acceptance-section-present",
      "check": "Task has acceptance section",
      "run": "grep -q '^## Acceptance criteria' .plaesy/tasks/*/high_feature-implement-design-code-ir-round-trip/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "spec-index-lists-task",
      "check": "Spec task index lists this task",
      "run": "grep -q 'high_feature-implement-design-code-ir-round-trip' .plaesy/spec/plaesy-agent-platform/spec.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "adr-accepted-before-start",
      "check": "Blocking ADR task is marked accepted in decisions",
      "run": "grep -q -i 'ir adr.*accepted' docs/platform/decisions.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "rust-tests-pass",
      "check": "Locked Rust tests and Clippy pass for the IR crate or module",
      "run": "export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo fmt --check && cargo test --workspace --locked && cargo clippy --locked --all-targets -- -D warnings",
      "expected": "pass",
      "status": "pending",
      "evidence": "test"
    },
    {
      "id": "frontmatter-present",
      "check": "task.md has spec, topic and status frontmatter",
      "run": "head -1 .plaesy/tasks/*/high_feature-implement-design-code-ir-round-trip/task.md | grep -q '^---$' && grep -q '^spec:' .plaesy/tasks/*/high_feature-implement-design-code-ir-round-trip/task.md && grep -q '^status:' .plaesy/tasks/*/high_feature-implement-design-code-ir-round-trip/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "cargo-focused-tests",
      "check": "Focused tests matching 'design_code_ir' run and at least one passes",
      "run": "export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo test --workspace --locked design_code_ir 2>&1 | grep -E '^test result' | awk '{s+=$4} END {print s+0}'",
      "expected": ">= 1",
      "status": "pending",
      "evidence": "test"
    }
  ]
}
