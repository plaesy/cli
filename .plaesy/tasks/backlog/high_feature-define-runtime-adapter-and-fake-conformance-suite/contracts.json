{
  "id": "high_feature-define-runtime-adapter-and-fake-conformance-suite",
  "checklist": [
    {
      "id": "task-file-present",
      "check": "Task file exists",
      "run": "test -s .plaesy/tasks/*/high_feature-define-runtime-adapter-and-fake-conformance-suite/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "acceptance-section-present",
      "check": "Task has acceptance criteria section",
      "run": "grep -q '^## Acceptance criteria' .plaesy/tasks/*/high_feature-define-runtime-adapter-and-fake-conformance-suite/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "spec-index-lists-task",
      "check": "Spec task index lists this task",
      "run": "grep -q 'high_feature-define-runtime-adapter-and-fake-conformance-suite' .plaesy/spec/plaesy-agent-platform/spec.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "frontmatter-present",
      "check": "task.md has spec, topic and status frontmatter",
      "run": "head -1 .plaesy/tasks/*/high_feature-define-runtime-adapter-and-fake-conformance-suite/task.md | grep -q '^---$' && grep -q '^spec:' .plaesy/tasks/*/high_feature-define-runtime-adapter-and-fake-conformance-suite/task.md && grep -q '^status:' .plaesy/tasks/*/high_feature-define-runtime-adapter-and-fake-conformance-suite/task.md",
      "expected": "pass",
      "status": "pending",
      "evidence": "doc"
    },
    {
      "id": "focused-tests",
      "check": "Focused tests matching 'adapter_conformance' run and at least one passes",
      "run": "export PATH=\"$HOME/.cargo/bin:$PATH\" && cargo test --locked adapter_conformance 2>&1 | grep -E '^test result' | awk '{s+=$4} END {print s+0}'",
      "expected": ">= 1",
      "status": "pending",
      "evidence": "test"
    }
  ]
}
