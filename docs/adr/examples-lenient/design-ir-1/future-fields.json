{
  "ir": "design-ir/1",
  "id": "dsg_order_desk",
  "version": 1,
  "name": "order-desk-ui",
  "tokens": {
    "color": {
      "primary": {
        "$type": "color",
        "$value": "#2563EB"
      },
      "danger": {
        "$type": "color",
        "$value": "#DC2626"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "text": {
        "$type": "color",
        "$value": "#111827"
      }
    },
    "space": {
      "sm": {
        "$type": "dimension",
        "$value": "8px"
      },
      "md": {
        "$type": "dimension",
        "$value": "16px"
      },
      "lg": {
        "$type": "dimension",
        "$value": "24px"
      }
    },
    "radius": {
      "md": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "font": {
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "Inter",
          "fontSize": "14px",
          "fontWeight": 400
        }
      }
    },
    "shadow": {
      "card": {
        "$type": "shadow",
        "$value": {
          "color": "rgba(0,0,0,0.1)",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      }
    }
  },
  "components": [
    {
      "id": "cp_button",
      "name": "Button",
      "root": {
        "id": "nd_button_root",
        "type": "frame",
        "layout": {
          "mode": "auto",
          "direction": "horizontal",
          "padding": "space.sm",
          "gap": "space.sm",
          "align": "center"
        },
        "style": {
          "fill": "color.primary",
          "radius": "radius.md",
          "text_color": "color.surface"
        },
        "children": [
          {
            "id": "nd_button_label",
            "type": "text",
            "text": "Label",
            "style": {
              "font": "font.body",
              "text_color": "color.surface"
            }
          }
        ]
      },
      "variants": {
        "tone": [
          "primary",
          "danger"
        ],
        "size": [
          "sm",
          "md"
        ]
      }
    }
  ],
  "pages": [
    {
      "id": "pg_orders",
      "name": "Orders",
      "frames": [
        {
          "id": "nd_orders_frame",
          "type": "frame",
          "name": "Orders",
          "x": 0,
          "y": 0,
          "width": 1280,
          "height": 800,
          "layout": {
            "mode": "auto",
            "direction": "vertical",
            "padding": "space.lg",
            "gap": "space.md"
          },
          "style": {
            "fill": "color.surface"
          },
          "children": [
            {
              "id": "nd_title",
              "type": "text",
              "text": "Total pesanan per pelanggan",
              "style": {
                "font": "font.body",
                "text_color": "color.text"
              },
              "future_prop": {
                "kind": "x"
              }
            },
            {
              "id": "nd_cancel",
              "type": "instance",
              "component": "cp_button",
              "variant": {
                "tone": "danger",
                "size": "md"
              }
            }
          ]
        }
      ]
    }
  ],
  "future_root_note": "ditulis oleh versi lebih baru"
}
