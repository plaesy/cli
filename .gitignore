# Generated by Cargo
# will have compiled files and executables
debug
target
dist

.kilo*
.claude*
# Keep durable Plaesy project specs, task contracts and task state in version control.
.plaesy*/
!.plaesy/
!.plaesy/**/
!.plaesy/spec/
!.plaesy/spec/**
!.plaesy/tasks/
!.plaesy/tasks/**
!.plaesy/memory/
!.plaesy/memory/**
!.plaesy/decisions/
!.plaesy/decisions/**
!.plaesy/config/
!.plaesy/config/**
!.plaesy/README.md
!.plaesy/MEMORY.md
!.plaesy/AGENTS.md

# Machine-local Plaesy state: presence locks, task receipts and usage analysis. These come after
# the whitelist above, so they win over the `!.plaesy/**` re-inclusion.
.plaesy/presence/
.plaesy/receipts/
.plaesy/analysis/

# Local tool caches and sync markers (machine-local).
.pytest_cache/
.stfolder/

# Local Plaesy indexes/caches remain machine-local.
.plaesy/index/
.plaesy/cache/
.plaesy/*.db
.plaesy/*.sqlite*

AGENTS.md
CLAUDE.md

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# rustc will dump stack traces when hitting an internal compiler error to PWD
rustc-ice-*.txt

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/

__pycache__/
*.pyc

# Build artifacts from separate target dirs (LME, experiments)
target-*/
memory.exe

# Runtime lock for the issue graph; never committed
.plaesy/tasks/.issue-graph.lock
